<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <application
        android:name=".PitCrewApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PitCrew">

        <!-- 주행 중에는 조작 요소 없는 주행 화면만 보이므로 DO로 선언한다. 미선언 앱은 주행 중 시스템이 가린다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- 문서 표기(함수명)와 에뮬레이터 Gleo 실제 전송(패키지명.함수명)을 모두 받는다.
             Gleo만 가진 서명 권한을 요구해 다른 앱이 주문·문자 같은 명령을 보내지 못하게 한다 -->
        <receiver
            android:name=".gleo.GleoActionReceiver"
            android:exported="true"
            android:permission="ai.umos.gleo.permission.APP_ACTION">
            <intent-filter>
                <action android:name="NOTIFY_LATE_ARRIVAL" />
                <action android:name="ai.pitcrew.app.NOTIFY_LATE_ARRIVAL" />
                <action android:name="ORDER_PICKUP_ON_ROUTE" />
                <action android:name="ai.pitcrew.app.ORDER_PICKUP_ON_ROUTE" />
                <action android:name="CANCEL_LAST_ERRAND" />
                <action android:name="ai.pitcrew.app.CANCEL_LAST_ERRAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
