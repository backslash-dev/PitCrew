<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <application
        android:name=".PitCrewApplication"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PitCrew">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 문서 표기(함수명)와 에뮬레이터 Gleo 실제 전송(패키지명.함수명)을 모두 받는다 -->
        <receiver
            android:name=".gleo.GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="NOTIFY_LATE_ARRIVAL" />
                <action android:name="ai.pitcrew.app.NOTIFY_LATE_ARRIVAL" />
                <action android:name="ORDER_PICKUP_ON_ROUTE" />
                <action android:name="ai.pitcrew.app.ORDER_PICKUP_ON_ROUTE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
